{
	"name": "@omusubimd/packages-unified",
	"private": true,
	"license": "MIT",
	"workspaces": [
		"packages/*"
	],
	"type": "module",
	"scripts": {
		"lint": "oxlint --no-error-on-unmatched-pattern",
		"lint:fix": "oxlint --fix --no-error-on-unmatched-pattern",
		"format": "oxfmt --write .",
		"format:check": "oxfmt --check .",
		"check": "npm run format:check && npm run lint && npm run typecheck",
		"prepare": "husky",
		"format:staged": "lint-staged",
		"test": "vitest run",
		"test:watch": "vitest",
		"typecheck": "tsc --noEmit",
		"build": "npm run build --workspaces --if-present"
	},
	"devDependencies": {
		"@types/node": "26.5.1",
		"husky": "9.1.7",
		"lint-staged": "17.5.1",
		"oxfmt": "0.67.0",
		"oxlint": "1.82.0",
		"typescript": "7.0.2",
		"vitest": "5.0.0"
	},
	"lint-staged": {
		"*": "oxfmt --write --no-error-on-unmatched-pattern"
	}
}
